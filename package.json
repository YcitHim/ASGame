{
  "name": "rust-and-blood",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "锈与血（暂名）· H5 肉鸽卡牌",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "validate": "tsx tools/content-validator/src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run typecheck && npm run validate && npm run test:coverage && npm run sim -- 100",
    "test:coverage": "vitest run --coverage",
    "sim": "tsx tools/headless-sim/src/cli.ts",
    "sim:elite": "tsx tools/headless-sim/src/cli.ts --scenario elite_warden",
    "record:golden": "tsx tools/headless-sim/src/record-golden.ts",
    "test:replay": "vitest run tests/unit/golden-replay.spec.ts"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12",
    "zod": "^4.6.5"
  }
}
